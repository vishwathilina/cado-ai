BACKEND_URL=https://your-space.hf.space
UPLOADTHING_TOKEN=replace-with-your-uploadthing-token
# Local npm start cannot receive UploadThing cloud callbacks. Leave unset (or localhost).
# On Netlify / any public deploy:
#   UPLOADTHING_URL=https://your-app.netlify.app
#   UPLOADTHING_IS_DEV=false
# UPLOADTHING_URL must be the exact public HTTPS origin users open (no trailing slash).
# UPLOADTHING_URL=https://your-app.netlify.app
# UPLOADTHING_IS_DEV=false
