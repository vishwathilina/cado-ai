ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@YOUR-NEON-POOLER-HOST/neondb?ssl=require
# Use the Neon *-pooler* host (not the direct compute host) so each request
# does not open a fresh TLS connection to Postgres.
FRONTEND_URL=http://localhost:3000
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=1440
REFRESH_TOKEN_DAYS=1
COOKIE_SECURE=false
AI_BASE_URL=https://your-openai-compatible-provider.example/v1
AI_API_KEY=replace-me
AI_MODEL=your-model-name
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_LOCAL_ONLY=true
# Hugging Face Docker Space: use Dockerfile.huggingface (port 7860, BGE-M3 baked in).
UPLOADTHING_TOKEN=replace-me
MAX_UPLOAD_MB=25
